# ADVP development environment template.
# NEVER put real API keys in this file or in the repository.
# Provider API keys are stored in Windows Credential Manager via the UI.

# Runtime (all optional; defaults shown)
ADVP_HOST=127.0.0.1
ADVP_PORT=8765
ADVP_DATABASE_PATH=./.advp/advp.db
ADVP_BACKUP_DIR=./.advp/backups
ADVP_WORKSPACE_DIR=./workspace
ADVP_MAX_FILE_BYTES=5368709120
ADVP_PROFILE_SAMPLE_ROWS=100000
ADVP_ANALYSIS_SAMPLE_ROWS=10000
ADVP_RENDER_SAMPLE_ROWS=20000
ADVP_3D_MAX_ELEMENTS=50000000
ADVP_PREVIEW_ROWS=20
ADVP_ALLOW_PRIVATE_WEB=0
ADVP_IMPORT_CONCURRENCY=2
ADVP_TEXT_MAX_CHARS=2000000
ADVP_TEXT_MAX_FACTS=2000
ADVP_TEXT_AI_MAX_SNIPPETS=200
ADVP_LOG_LEVEL=INFO

# Optional independent VTK/Mayavi/trame renderer interpreter
# ADVP_RENDER_PYTHON=C:/envs/advp-3d/python.exe

# Optional local API token. When set, /api requests must send
# X-ADVP-Token, Authorization: Bearer <token>, or the session cookie.
# ADVP_AUTH_TOKEN=
# ADVP_SESSION_COOKIE=advp_session

# Optional packaged frontend directory (defaults to backend/static or frontend/dist)
# ADVP_STATIC_DIR=./frontend/dist

# Optional diagnostics log directory (defaults to ADVP_WORKSPACE_DIR/logs)
# ADVP_LOG_DIR=./logs
