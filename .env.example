# ADVP development environment template.
# NEVER put real API keys in this file or in the repository.
# Production keys are stored in Windows Credential Manager via the UI.

# OpenAI-compatible provider (example values)
ADVP_OPENAI_BASE_URL=https://api.openai.com/v1
ADVP_OPENAI_MODEL=gpt-4.1
ADVP_OPENAI_API_KEY=

# Anthropic-compatible provider (example values)
ADVP_ANTHROPIC_BASE_URL=https://api.anthropic.com
ADVP_ANTHROPIC_MODEL=claude-sonnet-4-5
ADVP_ANTHROPIC_API_KEY=

# Runtime
ADVP_LOG_LEVEL=INFO
ADVP_WORKSPACE=D:/ADVP/workspace
ADVP_MAX_CONCURRENCY=2
